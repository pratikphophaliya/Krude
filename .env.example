# ==============================================================================
# Krude - Optional API Keys & Environment Configuration
# ==============================================================================
# GDELT DOC 2.0 works 100% out of the box with NO API KEY REQUIRED.
# If you wish to plug in additional optional news APIs, configure below:
# ==============================================================================

# 1. Optional News API Key (from https://newsapi.org)
NEWS_API_KEY=""

# 1b. Optional GNews API Key (from https://gnews.io)
GNEWS_API_KEY=""

# News refresh interval in seconds (900 = 15 min keeps NewsAPI/GNews under 100 req/day)
NEWS_REFRESH_SECONDS=900

# 2. Local AI Model Server (Ollama running Krude-risk on NVIDIA RTX 3050 GPU)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="Krude-risk"

# 3. GDELT DOC 2.0 Endpoint (Free Public API - No Key Needed)
GDELT_DOC_API_URL="https://api.gdeltproject.org/api/v2/doc/doc"

# 4. Server Host & Port
HOST="127.0.0.1"
PORT=8000
